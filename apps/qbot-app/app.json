{
  "expo": {
    "name": "QBot",
    "slug": "qian-drive",
    "version": "1.0.11",
    "orientation": "default",
    "icon": "./assets/brand/icon-1024.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F3EFE7",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.github.felixzhu.qiandrive"
    },
    "android": {
      "package": "io.github.felixzhu.qiandrive",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground-1024.png",
        "backgroundColor": "#FF6A2B",
        "monochromeImage": "./assets/brand/adaptive-monochrome-1024.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "label": "QBot",
      "versionCode": 13
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FF6A2B",
          "dark": {
            "image": "./assets/brand/splash-icon.png",
            "backgroundColor": "#FF6A2B"
          }
        }
      ],
      "expo-image",
      "expo-video",
      "expo-updates",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/ef23ae82-73c0-4db5-b2d7-b2424f969697",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "extra": {
      "eas": {
        "projectId": "ef23ae82-73c0-4db5-b2d7-b2424f969697"
      }
    },
    "owner": "felixzhu"
  }
}

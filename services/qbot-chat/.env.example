# Copy to a mode 600 file outside the repo. Do not commit real values.
# The long-running service gets DATABASE_URL, not the superuser migrate URL.

# Runtime role. TCP localhost, scram-sha-256. Not a superuser.
DATABASE_URL=postgres://qbot:replace-with-role-password@127.0.0.1:5432/qbot

# Superuser, used only by `npm run migrate` because pgvector 0.8.7 is not a trusted extension.
# Do not put this in the service environment.
DATABASE_MIGRATE_URL=postgres://postgres:replace-with-superuser-password@127.0.0.1:5432/qbot

# One user until accounts exist. Stable UUID, not a credential.
QBOT_OWNER_ID=00000000-0000-4000-8000-000000000001

# Required unless QBOT_PERSONAL_OPEN=1. Never put it in the app.
QBOT_ACCESS_TOKEN=replace-with-a-long-random-token

# Private trial only. Exactly "1" lets the chat and history routes skip the bearer token.
# Any other value, including unset, keeps bearer auth. Do not open the database or other ports.
# QBOT_PERSONAL_OPEN=

# Server-only model key. The app never sees it.
OPENROUTER_API_KEY=replace-with-openrouter-key

# Optional. Unset uses the exact default deepseek/deepseek-v4.1-flash-1017.
# OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017

# DSH JSONL home. Mode 700 directory outside the repo on a server.
# QBOT_DSH_HOME=/var/lib/qbot/dsh-home

# Loopback only. A reverse proxy on this machine terminates HTTPS.
HOST=127.0.0.1
PORT=8787

# Test only. Leave both unset on a server. A fixture is not a model acceptance.
# QBOT_FIXTURE_UPSTREAM=1
# QBOT_FIXTURE_UPSTREAM_URL=http://127.0.0.1:9/v1/chat/completions

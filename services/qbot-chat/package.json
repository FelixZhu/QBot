    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "assistant-stream": "^0.3.58",
    "canonicalize": "^2.1.0",
    "parse5": "^7.3.0",
    "pg": "^8.16.3",
    "yauzl": "^2.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@types/pg": "^8.15.6",
